<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="change_status_wizard" model="ir.ui.view">
        <field name="name">Change Status Record</field>
        <field name="model">change.status</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="status" required="1"/>
                    <field name="reason" required="1"/>
                    <field name="todo_id" invisible="1"/>
                </group>
                <footer>
                    <button name="change_status" type="object" string="confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="bg-secondary "/>
                </footer>
            </form>
        </field>
    </record>
    <record id="change_status_action" model="ir.actions.act_window">
        <field name="name">Change status</field>
        <field name="res_model">change.status</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>