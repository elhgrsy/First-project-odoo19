<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="property_act_re" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">property</field>
        <field name="binding_model_id" ref="model_property"/>
        <field name="binding_type">report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">app_one.report_action_pro</field>
    </record>
    <template id="report_action_pro">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style>
                        table {
                        width:100%;
                        border: 1px solid #ddd;
                        border-collapse:collapse;
                        text-align: center;
                        font-size: 24px;
                        font-weight: bold;
                        color: #2c3e50;
                        margin-bottom: 20px;
                        padding: Spx;
                        }

                        table td {
                        background-color: #2fffff;
                        padding: Spx;
                        border: 1px solid #ddd;
                        font-size: 14px;
                        }

                        table th {
                        background-color: #2c3e50;
                        color: white;
                        padding: Spx;
                        }
                        .h1_info {
                        text-align: center;
                        color: #2c3e50;
                        }
                    </style>
                    <h1 class="h1_info">Property App</h1>
                    <div style="margin-top: 40px;">
                        <table>
                            <thead>
                                <th colspan="4">Info (Group One)</th>
                            </thead>
                            <tbody>
                                <td>Name</td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                                <td>Postcode</td>
                                <td>
                                    <span t-field="o.postcode"/>
                                </td>
                            </tbody>
                        </table>
                        <table>
                            <thead>
                                <th colspan="4">Info (Group Tow)</th>
                            </thead>
                            <tbody>
                                <td>Owner ID</td>
                                <td>
                                    <span t-field="o.owner_id"/>
                                </td>
                                <td>Living Area</td>
                                <td>
                                    <span t-field="o.living_area"/>
                                </td>
                            </tbody>
                        </table>
                        <br/>
                        <table>
                            <thead>
                                <th>Property ID</th>
                                <th>Area(x2)</th>
                                <th>Description</th>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="l">
                                    <tr>
                                        <td>
                                            <span t-field="l.property_id"/>
                                        </td>
                                        <td>
                                            <span t-field="l.area"/>
                                        </td>
                                        <td>
                                            <span t-field="l.description"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
