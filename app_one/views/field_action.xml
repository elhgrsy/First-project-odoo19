<odoo>
    <record id="property_list_view" model="ir.ui.view">
        <field name="name">Property list</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <list decoration-danger="(is_lose)">
                <field name="pro_date"/>
                <field name="state"/>
                <field name="tags_ids" widget="many2many_tags"/>
                <field name="owner_id"/>
                <field name="name"/>
                <field name="description" optional="1"/>
                <field name="postcode"/>
                <field name="phone"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
            </list>
        </field>
    </record>
    <record id="property_form_view" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                                    <header>
                        <button name="action_draft" type="object" class="btn-primary" string="Draft"
                                invisible="state in ('draft','closed','confirmed')"/>
                        <button name="action_confirmed" type="object" class="btn-info" string="Confirmed"
                                invisible="state in ('draft','closed','confirmed')"/>
                        <button name="action_pending" type="object" class="btn-secondary" string="Pending"
                                invisible="state in ('closed','pending')"/>
                        <button name="action_sold" type="object" class="btn-success" string="Sold"
                                invisible="state in ('draft','closed','sold')"/>
                        <field name="state"
                               widget="statusbar"/><!--options="{'clickable': 1}"  علي شان يدي حريه في التحرك بين القوايم /  statusbar_visible=الي هيظهر في البار-->
                    </header>
                <sheet>
                     <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                    <div name="button_box" class="oe_button_box">
                        <button name="owner_action"
                                icon="fa-user"
                                type="object"
                                string="Owner"
                                invisible="not owner_id"/>
                    </div>


                    <div class="one_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref"/>
                        </h1>
                        <label for="name"/>
                        <h3>
                            <field name="name" readonly="state == 'closed'"/>
                        </h3>
                    </div>
                    <group>
                        <group string="group_one">
                            <field name="description" optional="1"/>
                            <field name="active" readonly="1"/>
                            <field name="postcode" readonly="state == 'closed'"/>
                            <field name="phone" readonly="state == 'closed'"/>
                            <field name="selling_price" readonly="state == 'closed'"/>
                            <field name="bedrooms" readonly="state == 'closed'"/>
                            <field name="bathrooms" readonly="state == 'closed'"/>
                            <field name="btw_room" readonly="state == 'closed'"/>
                        </group>
                        <group string="group_tow">
                            <field name="pro_date" readonly="state == 'closed'"/>
                            <field name="create_time" readonly="1"/>
                            <field name="new_time" readonly="1"/>
                            <field name="is_lose" readonly="state == 'closed'"/>
                            <field name="tags_ids" widget="many2many_tags" readonly="state == 'closed'"/>
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="living_area" readonly="state == 'closed'"/>
                            <field name="facades" readonly="state == 'closed'"/>
                            <field name="garage"
                                   invisible="garden == True" readonly="state == 'closed'"/>
                            <field name="garden"
                                   invisible="garage == True" readonly="state == 'closed'"/>
                            <field name="garden_area" readonly="state == 'closed'"/>
                            <field name="garden_orientation" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bedrooms">
                            <field name="line_ids">
                                <list editable="bottom">       <!--editable="bottom" ==> دي بتخليك تدخل البيانات علي طول من غير ماتفتح نافزه تانيه-->
                                    <field name="property_id"/>
                                    <field name="description"/>
                                    <field name="area"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Property Action</field>
        <field name="res_model">property</field>
    </record>
    <record id="property_search_view" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="postcode"/>
                <field name="name"/>
                <filter name="phone" string="with phone" domain="[('phone', '=', True)]"/>
                <filter name="no phone" string="without phone" domain="[('phone', '=', False)]"/>
                <filter name="gr_by garage" string="group by garage" context="{'group_by' : 'garage'}"/>
            </search>
        </field>
    </record>
    <record id="closed_action_property" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_property"/>    <!-- دي لي form -->
        <field name="binding_model_id" ref="model_property"/>     <!-- دي لي list -->
        <field name="state">code</field>
        <field name="code">
            action = records.action_closed()
        </field>
    </record>
    <record id="wizerd_change_stat" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_property"/>    <!-- دي لي form -->
        <field name="binding_model_id" ref="model_property"/>     <!-- دي لي list -->
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_change_state_wizerd()
        </field>
    </record>
    <record id="pro_date_atumation_action" model="ir.cron">
        <field name="name">Property: Pro Date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            model.check_pro_date()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">1</field>
    </record>
    <menuitem
            id="action_three"
            name="properties"
            parent="action_tow"
            action="property_action"
    />
</odoo>