<odoo>
    <record id="record_wizerd_change_state_form" model="ir.ui.view">
        <field name="name">wizerd Change State Form</field>
        <field name="model">change.state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="property_id" invisible="1"/>
                    <field name="state" required="1"/>
                    <field name="reason" required="1"/>
                </group>
                <footer>
                    <button name="action_replace" type="object" string="Replace" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="record_wizerd_change_state_action" model="ir.actions.act_window">
        <field name="name">Change State Action</field>
        <field name="res_model">change.state</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>